<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application android:label="SCDA Local Setup Test" android:extractNativeLibs="true" tools:replace="android:label">
        <activity android:name="io.github.mogeldev.scda.OnDeviceSetupActivity" tools:node="remove" />
        <activity-alias android:name="io.github.mogeldev.scda.SetupActivity" tools:node="remove" />
        <activity android:name="io.github.mogeldev.scda.LocalSetupActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
